# 环境变量配置文件示例
# 复制此文件为 .env 并填写实际配置

# Flask 配置
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# 数据库配置 (MySQL)
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/electric_inspection

# C++ 推理服务配置
CPP_SERVICE_URL=http://localhost:8080

# 七牛云 OSS 配置
QINIU_AK=your-qiniu-access-key
QINIU_SK=your-qiniu-secret-key
QINIU_BUCKET=electric-inspection
QINIU_DOMAIN=http://your-cdn-domain.com
